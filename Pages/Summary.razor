@page "/summary"
@using SmartSpendHome.Models
@inject SmartSpendHome.Services.ExpenseService ExpenseService
@inject SmartSpendHome.Services.ShoppingService ShoppingService

<h3>Summary</h3>

<div class="summary-container">

    <div class="card">
        <h4>Total Spent</h4>
        <h2>$@totalSpent.ToString("0.00")</h2>
    </div>

    <div class="card">
        <h4>Essential</h4>
        <p>$@essentialSpent.ToString("0.00")</p>
    </div>

    <div class="card">
        <h4>Optional</h4>
        <p>$@optionalSpent.ToString("0.00")</p>
    </div>

    <div class="card">
        <h4>Groceries</h4>
        <p>$@groceriesSpent.ToString("0.00")</p>
    </div>

    <div class="card">
        <h4>Shopping Total</h4>
        <p>$@shoppingTotal.ToString("0.00")</p>
    </div>

    <div class="card">
        <h4>Planned Estimate</h4>
        <p>$@plannedEstimate.ToString("0.00")</p>
    </div>

    <div class="card">
        <h4>Over Plan</h4>
        <p>$@overPlanAmount.ToString("0.00")</p>
    </div>

    <div class="card">
        <h4>Items Bought</h4>
        <p>@itemsBoughtCount</p>
    </div>

</div>

<h4 class="section-title">Shopping Trips</h4>

<div class="list">
    @foreach (var item in shoppingExpenses.OrderByDescending(x => x.Date))
    {
        var selectedShoppingItems = GetShoppingItemsForExpense(item);
        var estimate = selectedShoppingItems.Sum(x => x.EstimatedPrice);
        var difference = item.Amount - estimate;

        <div class="list-item">
            <div>
                <strong>$@item.Amount.ToString("0.00")</strong>
                <div class="small">@item.Store - @item.Date.ToShortDateString()</div>
                <div class="small">
                    Planned estimate: $@estimate.ToString("0.00")
                </div>
                <div class="small">
                    Difference: $@difference.ToString("0.00")
                </div>

                @if (selectedShoppingItems.Any())
                {
                    <div class="small">
                        Items: @string.Join(", ", selectedShoppingItems.Select(x => x.Name))
                    </div>
                }
                else
                {
                    <div class="small">No shopping items selected</div>
                }
            </div>
        </div>
    }
</div>

<h4 class="section-title">Recent Expenses</h4>

<div class="list">
    @foreach (var item in expenses.OrderByDescending(x => x.Date))
    {
        <div class="list-item">
            <div>
                <strong>$@item.Amount.ToString("0.00")</strong>
                <div class="small">@item.Category - @item.Store</div>

                @if (item.IsFromShopping)
                {
                    <div class="small">Shopping Trip</div>
                }
            </div>

            <div class="right">
                <div class="small">@item.Date.ToShortDateString()</div>
                <div class="small">@item.PaymentMethod</div>
            </div>
        </div>
    }
</div>

@code {
    private List<Expense> expenses = new();
    private List<ShoppingItem> shoppingItems = new();
    private List<Expense> shoppingExpenses = new();

    private decimal totalSpent;
    private decimal essentialSpent;
    private decimal optionalSpent;
    private decimal groceriesSpent;

    private decimal shoppingTotal;
    private decimal plannedEstimate;
    private decimal overPlanAmount;
    private int itemsBoughtCount;

    protected override async Task OnInitializedAsync()
    {
        expenses = await ExpenseService.GetAllAsync();
        shoppingItems = await ShoppingService.GetAllAsync();

        totalSpent = expenses.Sum(x => x.Amount);

        essentialSpent = expenses
            .Where(x => x.IsEssential)
            .Sum(x => x.Amount);

        optionalSpent = expenses
            .Where(x => !x.IsEssential)
            .Sum(x => x.Amount);

        groceriesSpent = expenses
            .Where(x => x.Category == "Groceries")
            .Sum(x => x.Amount);

        shoppingExpenses = expenses
            .Where(x => x.IsFromShopping)
            .ToList();

        shoppingTotal = shoppingExpenses.Sum(x => x.Amount);

        plannedEstimate = shoppingExpenses
            .SelectMany(x => x.ShoppingItemIds)
            .Distinct()
            .Select(id => shoppingItems.FirstOrDefault(s => s.Id == id))
            .Where(x => x is not null)
            .Sum(x => x!.EstimatedPrice);

        overPlanAmount = shoppingTotal - plannedEstimate;

        if (overPlanAmount < 0)
            overPlanAmount = 0;

        itemsBoughtCount = shoppingExpenses
            .SelectMany(x => x.ShoppingItemIds)
            .Distinct()
            .Count();
    }

    private List<ShoppingItem> GetShoppingItemsForExpense(Expense expense)
    {
        return shoppingItems
            .Where(x => expense.ShoppingItemIds.Contains(x.Id))
            .ToList();
    }
}